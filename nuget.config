<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- StandSure.Functional comes from the org's GitHub Packages feed. The source is named "github" because the Oui-DELIVER workflows pass credentials as NuGetPackageSourceCredentials_github. Reading it needs a token with read:packages. -->
    <add key="github" value="https://nuget.pkg.github.com/stand-sure-org/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="StandSure.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
