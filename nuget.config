<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- StandSure.Functional is published to the org's GitHub Packages feed; reading it needs a token with read:packages. -->
    <add key="stand-sure-org" value="https://nuget.pkg.github.com/stand-sure-org/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="stand-sure-org">
      <package pattern="StandSure.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
