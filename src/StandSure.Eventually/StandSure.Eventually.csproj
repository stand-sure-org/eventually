<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>$(EventuallyRootName)</RootNamespace>
    <AssemblyName>$(EventuallyRootName)</AssemblyName>
    <PackageId>$(EventuallyRootName)</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>C. J. Anderson</Authors>
    <Company>Stand Sure, LLC</Company>
    <Description>One uniform CloudEvents message per persisted mutation, over a backend chosen by dependency injection.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(EventuallyPackageOutputPath)</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StandSure.Functional" />
  </ItemGroup>
</Project>
